# p3sksx (kor_single)
on early-init && property:ro.boot.em.model=SM-G998N
    # Firmware blobs
    mount none /vendor/firmware/SM-G998N/AP_AUDIO_SLSI.bin /vendor/firmware/AP_AUDIO_SLSI.bin bind
    mount none /vendor/firmware/SM-G998N/APDV_AUDIO_SLSI.bin /vendor/firmware/APDV_AUDIO_SLSI.bin bind
    mount none /vendor/firmware/SM-G998N/calliope_sram.bin /vendor/firmware/calliope_sram.bin bind
    mount none /vendor/firmware/SM-G998N/dsp_master.bin /vendor/firmware/dsp_master.bin bind
    mount none /vendor/firmware/SM-G998N/is_rta.bin /vendor/firmware/is_rta.bin bind
    mount none /vendor/firmware/SM-G998N/mfc_fw.bin /vendor/firmware/mfc_fw.bin bind
    mount none /vendor/firmware/SM-G998N/NPU.bin /vendor/firmware/NPU.bin bind
    mount none /vendor/firmware/SM-G998N/rsxe.bin /vendor/firmware/rsxe.bin bind
    mount none /vendor/firmware/SM-G998N/SoundBoosterParam.bin /vendor/firmware/SoundBoosterParam.bin bind
    mount none /vendor/firmware/SM-G998N/vts.bin /vendor/firmware/vts.bin bind
    mount none /vendor/firmware/SM-G998N/bt_vendor_rf.xml /vendor/firmware/bt_vendor_rf.xml bind
    mount none /vendor/firmware/SM-G998N/nfc/libsn100u_fw.bin /vendor/firmware/nfc/libsn100u_fw.bin bind
    mount none /vendor/firmware/SM-G998N/wifi/nvram.txt_ES32_semco_c0 /vendor/firmware/wifi/nvram.txt_ES32_semco_c0 bind
    mount none /vendor/firmware/SM-G998N/wifi/nvram.txt_ES40_semco_c1 /vendor/firmware/wifi/nvram.txt_ES40_semco_c1 bind
    mount none /vendor/firmware/SM-G998N/wifi/nvram_ES40_semco_c1 /vendor/firmware/wifi/nvram_ES40_semco_c1 bind
    
    # TEEgris
    mount none /vendor/tee_SM-G998N /vendor/tee bind

# p3sxxx (eur_open)
on early-init && property:ro.boot.em.model=SM-G998B
    # Firmware blobs
    mount none /vendor/firmware/SM-G998B/AP_AUDIO_SLSI.bin /vendor/firmware/AP_AUDIO_SLSI.bin bind
    mount none /vendor/firmware/SM-G998B/APDV_AUDIO_SLSI.bin /vendor/firmware/APDV_AUDIO_SLSI.bin bind
    mount none /vendor/firmware/SM-G998B/calliope_sram.bin /vendor/firmware/calliope_sram.bin bind
    mount none /vendor/firmware/SM-G998B/dsp_master.bin /vendor/firmware/dsp_master.bin bind
    mount none /vendor/firmware/SM-G998B/is_rta.bin /vendor/firmware/is_rta.bin bind
    mount none /vendor/firmware/SM-G998B/mfc_fw.bin /vendor/firmware/mfc_fw.bin bind
    mount none /vendor/firmware/SM-G998B/NPU.bin /vendor/firmware/NPU.bin bind
    mount none /vendor/firmware/SM-G998B/rsxe.bin /vendor/firmware/rsxe.bin bind
    mount none /vendor/firmware/SM-G998B/SoundBoosterParam.bin /vendor/firmware/SoundBoosterParam.bin bind
    mount none /vendor/firmware/SM-G998B/vts.bin /vendor/firmware/vts.bin bind
    mount none /vendor/firmware/SM-G998B/bt_vendor_rf.xml /vendor/firmware/bt_vendor_rf.xml bind
    mount none /vendor/firmware/SM-G998B/nfc/libsn100u_fw.bin /vendor/firmware/nfc/libsn100u_fw.bin bind
    mount none /vendor/firmware/SM-G998B/wifi/nvram.txt_ES32_semco_c0 /vendor/firmware/wifi/nvram.txt_ES32_semco_c0 bind
    mount none /vendor/firmware/SM-G998B/wifi/nvram.txt_ES40_semco_c1 /vendor/firmware/wifi/nvram.txt_ES40_semco_c1 bind
    mount none /vendor/firmware/SM-G998B/wifi/nvram.txt_1wk_es40_c0 /vendor/firmware/wifi/nvram.txt_1wk_es40_c0 bind
    mount none /vendor/firmware/SM-G998B/wifi/nvram.txt_1wk_es41_c0 /vendor/firmware/wifi/nvram.txt_1wk_es41_c0 bind
    mount none /vendor/firmware/SM-G998B/wifi/nvram.txt_4389_3321 /vendor/firmware/wifi/nvram.txt_4389_3321 bind

on boot
    restart audioserver