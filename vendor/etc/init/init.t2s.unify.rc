# t2sksx (kor_single)
on early-init && property:ro.boot.em.model=SM-G996N
    # Firmware blobs
    mount none /vendor/firmware/SM-G996N/nvram.txt_1rh_es43_b1 /vendor/firmware/nvram.txt_1rh_es43_b1 bind
    mount none /vendor/firmware/SM-G996N/nvram.txt_CS01_semco_b1 /vendor/firmware/nvram.txt_CS01_semco_b1 bind
    mount none /vendor/firmware/SM-G996N/AP_AUDIO_SLSI.bin /vendor/firmware/AP_AUDIO_SLSI.bin bind
    mount none /vendor/firmware/SM-G996N/APDV_AUDIO_SLSI.bin /vendor/firmware/APDV_AUDIO_SLSI.bin bind
    mount none /vendor/firmware/SM-G996N/calliope_sram.bin /vendor/firmware/calliope_sram.bin bind
    mount none /vendor/firmware/SM-G996N/dsp_master.bin /vendor/firmware/dsp_master.bin bind
    mount none /vendor/firmware/SM-G996N/is_rta.bin /vendor/firmware/is_rta.bin bind
    mount none /vendor/firmware/SM-G996N/mfc_fw.bin /vendor/firmware/mfc_fw.bin bind
    mount none /vendor/firmware/SM-G996N/NPU.bin /vendor/firmware/NPU.bin bind
    mount none /vendor/firmware/SM-G996N/rxse.bin /vendor/firmware/rxse.bin bind
    mount none /vendor/firmware/SM-G996N/SoundBoosterParam.bin /vendor/firmware/SoundBoosterParam.bin bind
    mount none /vendor/firmware/SM-G996N/vts.bin /vendor/firmware/vts.bin bind
    mount none /vendor/firmware/SM-G996N/nfc/libsn100u_fw.so /vendor/firmware/nfc/libsn100u_fw.so bind

    # TEEgris
    mount none /vendor/tee_SM-G996N /vendor/tee bind

# t2sxxx (eur_open)
on early-init && property:ro.boot.em.model=SM-G996B
    # Firmware blobs
    mount none /vendor/firmware/SM-G996B/nvram.txt_1rh_es43_b1 /vendor/firmware/nvram.txt_1rh_es43_b1 bind
    mount none /vendor/firmware/SM-G996B/nvram.txt_CS01_semco_b1 /vendor/firmware/nvram.txt_CS01_semco_b1 bind
    mount none /vendor/firmware/SM-G996B/AP_AUDIO_SLSI.bin /vendor/firmware/AP_AUDIO_SLSI.bin bind
    mount none /vendor/firmware/SM-G996B/APDV_AUDIO_SLSI.bin /vendor/firmware/APDV_AUDIO_SLSI.bin bind
    mount none /vendor/firmware/SM-G996B/calliope_sram.bin /vendor/firmware/calliope_sram.bin bind
    mount none /vendor/firmware/SM-G996B/dsp_master.bin /vendor/firmware/dsp_master.bin bind
    mount none /vendor/firmware/SM-G996B/is_rta.bin /vendor/firmware/is_rta.bin bind
    mount none /vendor/firmware/SM-G996B/mfc_fw.bin /vendor/firmware/mfc_fw.bin bind
    mount none /vendor/firmware/SM-G996B/NPU.bin /vendor/firmware/NPU.bin bind
    mount none /vendor/firmware/SM-G996B/rxse.bin /vendor/firmware/rxse.bin bind
    mount none /vendor/firmware/SM-G996B/SoundBoosterParam.bin /vendor/firmware/SoundBoosterParam.bin bind
    mount none /vendor/firmware/SM-G996B/vts.bin /vendor/firmware/vts.bin bind
    mount none /vendor/firmware/SM-G996B/nfc/libsn100u_fw.so /vendor/firmware/nfc/libsn100u_fw.so bind

on boot
    restart audioserver